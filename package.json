{
  "name": "@andygo.dev/emitter",
  "version": "1.0.2",
  "description": "Type-safe wrapper around @nestjs/event-emitter with an error-catching @OnEmitterEvent decorator.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "lint": "eslint \"{src,tests}/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"{src,tests}/**/*.ts\" --max-warnings=0 --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "example:complex": "ts-node --project tsconfig.examples.json examples/main.ts",
    "prepublishOnly": "npm run clean && npm run build",
    "preversion": "npm run lint && npm test && npm run build",
    "postversion": "git push --follow-tags && npm publish --access public",
    "deploy": "npm version patch",
    "deploy:minor": "npm version minor",
    "deploy:major": "npm version major"
  },
  "keywords": [
    "nestjs",
    "event-emitter",
    "events",
    "typescript",
    "decorator"
  ],
  "author": "Andy Kramar <andygo.develop@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/event-emitter": "^2.0.0 || ^3.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/testing": "^11.1.3",
    "@types/jest": "29.5.14",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "jest": "29.7.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "ts-jest": "29.2.5",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/tests/**/*.spec.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json",
          "diagnostics": true
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/index.ts"
    ]
  }
}
